# The Haven servers Havoc connects to, as one line of JSON (keep the single quotes).
#   name      required, unique, one word: shown in logs and used by ?remote.
#             Renaming a server later detaches it from its saved data.
#   url       the server's address, no trailing slash
#   username  the bot's account on that server (two-factor auth off)
#   password  that account's password
#   admins    optional: Haven user ids allowed to use admin commands there
#             (?id shows ids). Leave it out or use [] for no admins.
# Inside the JSON, write a " or \ in a password as \" or \\. A password
# containing a single quote ' can't be used here.
# A server with a missing or duplicate name, or a bad entry, is skipped with
# the reason logged; the others still connect.
SERVERS='[{"name":"Community","url":"https://haven.example.com","username":"havoc","password":"change-me","admins":[1]}]'

# What messages must start with, e.g. "?fish"
PREFIX=?

# Where the database lives (default: havoc.db next to the code)
# DB_PATH=/home/ubuntu/havoc/havoc.db

# Only for testing against a local server with a self-signed certificate
# HAVEN_INSECURE_TLS=1
