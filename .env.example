# Haven server Havoc connects to (no trailing slash)
HAVEN_URL=http://localhost:3917

# Havoc logs in as a normal account. Make one for it; don't use your own.
# Two-factor auth must be off on this account.
HAVOC_USERNAME=havoc
HAVOC_PASSWORD=change-me

# What messages must start with, e.g. "h!cat"
PREFIX=h!

# Only for testing against a local server with a self-signed certificate
# HAVEN_INSECURE_TLS=1
